{
  "schema_name": "canonical_legal_operator_spec",
  "version": "3.0",
  "description": "Canonical legal operator specification aligned to V2 process map. Signal is constructed inside USE_reasoning, not at the world layer. Z2 is distributed across recognition, plausibility, authority, merits, verdict, remedy, and judgment. Path 1 and Path 2 are integrated in one executable schema.",
  "operator_semantics": {
    "A": "trigger into legal processing",
    "L": "recognition / cognizability threshold reasoning",
    "T": "plausibility / sufficiency threshold reasoning",
    "W": "authorization / bounded inference-space creation",
    "E": "evidentiary admissibility gate",
    "M1": "factfinding / State-Event Transition Structure construction and selection",
    "M2": "doctrinal classification / meaning assignment",
    "USE": "internal or external conduct",
    "USAGE": "institutional instantiation / commitment event",
    "Z2": "distributed validation family with authority to validate or invalidate committed institutional acts",
    "Z3": "outcome evaluation / acceptability review without direct corrective commitment power",
    "ZZ": "system-level review / appellate or supervisory audit"
  },
  "output_type_semantics": {
    "constructive": "creates an institutional artifact or durable legal object and therefore requires USAGE at the construction point",
    "constraint": "does not create an institutional artifact and instead limits, validates, invalidates, or conditions downstream use",
    "state_flip": "changes system status without creating a standalone institutional artifact",
    "mixed": "can produce both constraint effects and downstream constructive effects depending on outcome",
    "world": "world-level observation or state change outside institutional instantiation",
    "trigger": "initiates a processing lane but does not itself create a legal artifact"
  },
  "signal_semantics": {
    "definition": "Signal is constructed inside USE_reasoning from recorded world material. It is not formed at the world level.",
    "notes": [
      "Signal is typed and processed inside legal reasoning.",
      "Inference is staged and only fully occurs at M1.",
      "Meaning assignment occurs at M2.",
      "Continuity is a background resistance / expectation structure, not itself a threshold or consequence."
    ]
  },
  "signal_type_families": {
    "status_condition": "supports inference of legal status, condition, or relational position",
    "volition_consent": "supports inference of agreement, authorization, permission, or consent",
    "authority": "supports inference of legal authorization, burden allocation, or inference-space legitimacy",
    "causation": "supports inference of causal relation, consequence, or transition linkage",
    "reliance_expectation": "supports inference of reliance, inducement, expectation, or assent",
    "use_activation": "supports inference that relation or condition was activated into legally relevant conduct",
    "reasonableness_proportionality": "supports inference of reasonableness, proportionality, or calibrated deviation",
    "procedural_legitimacy": "supports inference of procedural validity, threshold compliance, and reasoning-space integrity"
  },
  "control_function_families": {
    "entry": "controls whether material may enter legal processing",
    "construction": "constructs signal or legal object from recorded material",
    "recognition": "tests whether a legally cognizable category exists",
    "plausibility": "tests whether facts plausibly justify proceeding",
    "admissibility": "filters the record into evidence usable by M1",
    "merits_screening": "tests whether a legally valid verdict could exist before trial",
    "factfinding": "constructs and selects one State-Event Transition Structure",
    "classification": "assigns doctrinal meaning to the selected State-Event Transition Structure",
    "support_validation": "tests whether a committed outcome is sufficiently supported",
    "acceptability": "tests whether a completed outcome is proportionate / fair / acceptable",
    "review": "audits correctness, reasoning validity, and procedural integrity"
  },
  "global_invariants": [
    "No liability exists at the world layer.",
    "Signal is not formed at the world layer; signal is constructed inside USE_reasoning.",
    "Inference is staged and only fully occurs at M1.",
    "Meaning lives at M2.",
    "Not every USE_reasoning step is followed by USAGE.",
    "Constructive outputs create artifacts and require USAGE.",
    "Constraint outputs do not create artifacts and do not require USAGE.",
    "Z2 is a distributed family, not a single checkpoint.",
    "Each Z2[x] audits a legally committed institutional act.",
    "Continuity is a background expectation and resistance structure against which typed signals are evaluated.",
    "Za is the evaluative field that tests whether processed signal strength is enough.",
    "Materiality is the threshold-crossing outcome of evaluation, not the evaluation process itself.",
    "M1 and M2 build.",
    "Z2 decides.",
    "Z3 judges.",
    "ZZ audits."
  ],
