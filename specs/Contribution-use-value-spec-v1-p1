  "schema_name": "canonical_use_allocation_spec",
  "version": "0.2.0",
  "description": "Canonical schema organized in the user's full sequence: Contribution -> Classification -> Use -> Benefit -> Retention -> Claim. This schema is the technical-operational encoding of that grammar and is designed to support deterministic traceability where available, classification where needed, benefit/retention analysis, and downstream claim formation.",
  "grammar_alignment": {
    "canonical_sequence": [
      "Contribution",
      "Classification",
      "Use",
      "Benefit",
      "Retention",
      "Claim"
    ],
    "populist_translation_layer": {
      "Contribution": "We contribute.",
      "Classification": "They organize it.",
      "Use": "They use it.",
      "Benefit": "It creates value.",
      "Retention": "They keep the value.",
      "Claim": "So we have a claim."
    }
  },
  "purpose": {
    "primary_function": "Track contribution, classification, use, benefit creation, retained benefit, and claim formation in a single canonical sequence.",
    "design_position": "Pre-legal, quasi-legal, and legal-handoff operational layer",
    "relationship_to_legal_operator_schema": "Feeds claim-ready records into a separate legal recognition, adjudication, remedy, and enforcement schema."
  },
  "operator_semantics": {
    "REGISTER": "records a contribution object and baseline status",
    "CLASSIFY": "types, structures, labels, groups, embeds, or otherwise organizes contribution into usable form",
    "TRACE_USE": "records an identifiable use event involving one or more classified contributions",
    "REALIZE_BENEFIT": "records direct or indirect value created through use",
    "ASSESS_RETENTION": "determines whether benefit was kept, shared, returned, limited, or withheld",
    "FORM_CLAIM": "packages contribution, classification, use, benefit, and retention into a claim-ready record"
  },
  "core_invariants": [
    "Contribution is analytically distinct from classification.",
    "Classification is required whenever raw inputs must be turned into usable typed structure, even where inputs are directly observed.",
    "Use is distinct from mere presence or storage.",
    "Benefit is distinct from retention.",
    "Retention is the keeping of benefit, not merely the existence of benefit.",
    "Claim pressure arises most sharply at retention, not at use alone.",
    "Deterministic traceability reduces later reconstruction but does not eliminate the need for classification.",
    "Legacy systems may preserve fragments of traceability without preserving the full chain.",
    "A contribution may be directly traceable, inferentially reconstructable, or both.",
    "A contribution may participate in multiple classifications, multiple uses, multiple benefits, and multiple claims.",
    "A claim may be economically intelligible before it is legally enforceable.",
    "This schema does not itself determine liability; it structures the claim field for later legal or institutional processing."
  ],
  "traceability_semantics": {
    "deterministic_traceability": "The system directly records the relevant link or event in a stable and reviewable form.",
    "classification_needed": "The system must convert recorded or observed material into typed usable structure.",
    "inferential_reconstruction": "The system must reconstruct missing links because the chain was not instrumented from the start."
  },
