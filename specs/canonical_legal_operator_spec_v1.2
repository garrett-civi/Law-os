{
  "schema_name": "canonical_legal_operator_spec",
  "version": "1.2",
  "description": "Formal operator schema for Path 1 coercive action and Path 2 adjudication/enforcement, updated to distinguish constructive, constraint, mixed, and state-flip outputs, and to explicitly model classification, signal formation, continuity context, control-function families, and Za threshold evaluation.",
  "operator_semantics": {
    "A": "trigger into legal processing",
    "L": "legal recognition / entry",
    "W": "authorization",
    "USE": "reasoning or execution activity",
    "USAGE": "institutional instantiation",
    "Z": "evaluation / review"
  },
  "output_type_semantics": {
    "constructive": "creates an institutional artifact or durable legal object and therefore requires USAGE at the construction point",
    "constraint": "does not create an institutional artifact; instead limits, validates, invalidates, or conditions downstream use",
    "state_flip": "changes system status or entry state without creating a standalone institutional artifact",
    "mixed": "can produce both constraint effects and downstream constructive effects depending on outcome",
    "world": "world-level observation or state change outside institutional instantiation",
    "trigger": "initiates a processing lane but does not itself create a legal artifact"
  },
  "signal_family_semantics": {
    "intent": "signal supports inference of purpose, motive, intent, or scienter",
    "knowledge_notice": "signal supports inference of awareness, knowledge, notice, or reason-to-know",
    "causation": "signal supports inference of causal connection, contribution, or consequence",
    "reliance_expectation": "signal supports inference of reliance, inducement, expectation, assent, or dependence",
    "aggregation_pattern": "signal supports inference of repetition, pattern, practice, policy, or systemic conduct",
    "normative_boundary": "signal supports inference of unfairness, bad faith, unreasonableness, deviation, or unjust enrichment"
  },
  "control_function_family_semantics": {
    "admissibility": "gates whether a signal may enter legal processing at all",
    "sufficiency": "tests whether the signal is strong enough to proceed to further reasoning or consequence",
    "construction": "permits the system to build meaning or inference from a signal",
    "constraint": "limits, narrows, or blocks extension of inference from a signal",
    "materiality": "tests whether evaluated signal strength is sufficient to justify consequence",
    "review": "audits whether the signal was processed, evaluated, and used correctly by the system"
  },
  "classification_mode_semantics": {
    "fixed": "classification is mechanically determined and not materially contestable at this stage",
    "contestable": "multiple plausible classifications may be argued before one is selected for signal formation"
  },
  "global_invariants": [
    "No liability exists in the world layer.",
    "Liability first becomes complete only after USAGE_verdict and successful Z_2 validation.",
    "Remedy is not liability; remedy follows liability.",
    "Judgment is not reasoning; judgment is institutional instantiation of the legal result.",
    "Enforcement is not built into adjudication; it requires W_e -> USAGE_e -> USE_world.",
    "Execution review is not automatic; it requires A_e.",
    "Not every USE_reasoning step is followed by USAGE.",
    "Constructive outputs create artifacts and require USAGE.",
    "Constraint outputs do not create artifacts and do not require USAGE.",
    "Z_2 and Z_3 consume prior instantiated artifacts but do not themselves instantiate new ones.",
    "Facts do not directly produce legal consequence; facts are classified into signals, and signals are processed through control functions before consequence.",
    "Classification is contestable at key reasoning stages; s5-style routing validates selected classifications but does not choose between competing plausible classifications.",
    "Signals are typed by signal families and processed by control-function families.",
    "Continuity is a background expectation and resistance structure, not itself a legal threshold.",
    "Za is the evaluative field that assesses signal strength against continuity and doctrine.",
    "Materiality is the threshold-crossing outcome of evaluation, not the evaluation process itself."
  ],
  "shared_schema_fragments": {
    "classification_template": {
      "classification_mode": "contestable",
      "candidate_classifications": [
        {
          "primitive_type": "event|condition|conduct",
          "fact_class": "generative_act|transitional_act|operative_act|activity_conduct|transformational_conduct|direct_conduct|object_condition|external_state_condition|internal_state_condition|direct_state_condition|latent_condition|activated_condition",
          "rationale": "why this mapping is plausible"
        }
      ],
      "selected_classification": {
        "primitive_type": "event|condition|conduct",
        "fact_class": "selected_fact_class",
        "selection_rationale": "why this classification governs downstream processing"
      },
      "signal_family": "intent|knowledge_notice|causation|reliance_expectation|aggregation_pattern|normative_boundary",
      "signal_source_fact_classes": [
        "fact_class_1",
        "fact_class_2"
      ]
    },
    "signal_template": {
      "signal_family": "intent|knowledge_notice|causation|reliance_expectation|aggregation_pattern|normative_boundary",
      "signal_direction": "what inference the signal supports",
      "signal_strength": "low|medium|high",
      "signal_clarity": "low|medium|high",
      "signal_specificity": "low|medium|high",
      "signal_consistency_with_pattern": "low|medium|high",
      "signal_observability": "low|medium|high",
      "signal_commitment_level": "low|medium|high",
      "signal_reversibility": "high|medium|low",
      "signal_corrobation_level": "low|medium|high",
      "signal_contradictions": [],
      "signal_notes": []
    },
    "continuity_context_template": {
      "relationship_exists": true,
      "relationship_type": "contractual|fiduciary|coercive_state_action|criminal_prosecution|property|risk_interaction|other",
      "continuity_density": "low|medium|high",
      "pattern_stability": "low|medium|high",
      "reliance_history": "low|medium|high",
      "counter_signals_present": false,
      "continuity_notes": []
    },
    "za_evaluation_template": {
      "evaluates_signal_against_continuity": true,
      "threshold_question": "is_signal_strong_enough_for_consequence",
      "signal_strength_factors": [],
      "continuity_resistance_factors": [],
      "doctrinal_threshold_factors": [],
      "threshold_result": "not_evaluated|not_met|met"
    }
  },
